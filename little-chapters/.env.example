# ──────────────────────────────────────────────────────────────────────────────
# Little Chapters environment configuration
# Copy to .env.local (web) and .env (worker). See docs/INTEGRATIONS.md for
# step-by-step instructions on connecting each real service.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin of the deployment. Used for QR/share URLs — must be a domain
# you intend to keep for the life of printed books (see docs/ARCHITECTURE.md §6).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database (Supabase Postgres or any Postgres 15+) ─────────────────────────
# Direct connection used by the server tier and worker (service role; RLS is
# enforced additionally in the authz layer). For Supabase use the pooled URL
# for the web tier and the direct URL for the worker/migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# ── Supabase (auth + storage) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# "supabase" in production; "local" writes to .local-storage/ for development.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage

# ── AI providers ─────────────────────────────────────────────────────────────
# AI_PROVIDER: "anthropic" | "null"  (null = deterministic templates, no network)
AI_PROVIDER=null
ANTHROPIC_API_KEY=
# Model used for generation tasks (captions, narratives, storybooks, suggestions)
AI_MODEL=claude-sonnet-5

# ── Transcription ────────────────────────────────────────────────────────────
# TRANSCRIPTION_PROVIDER: "openai_compatible" | "null"
TRANSCRIPTION_PROVIDER=null
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# ── Stripe billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Print fulfillment ────────────────────────────────────────────────────────
# PRINT_PROVIDER: "manual" | (future: "lulu", "peecho", ...)
PRINT_PROVIDER=manual

# ── Email / push notifications ───────────────────────────────────────────────
# EMAIL_PROVIDER: "resend_compatible" | "null"
EMAIL_PROVIDER=null
EMAIL_API_URL=https://api.resend.com
EMAIL_API_KEY=
EMAIL_FROM="Little Chapters <memories@littlechapters.example>"
# Web Push (generate once: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Media pipeline ───────────────────────────────────────────────────────────
# Absolute path to ffmpeg/ffprobe binaries used by the worker for video jobs.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Security ─────────────────────────────────────────────────────────────────
# 32+ char secret for signing short-lived media access tokens (rotate-safe:
# comma-separate old keys after the current one).
MEDIA_TOKEN_SECRET=change-me-to-a-long-random-string-please
# Secret for hashing share-link passwords alongside per-link salts.
APP_SECRET=change-me-too

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1500
